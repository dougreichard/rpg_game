; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hunkle Bunkle"
run/main_scene="res://scenes/ui/TitleScreen.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"
config/run/main_scene="res://scenes/ui/TitleScreen.tscn"

[autoload]

SaveManager="*res://scripts/autoload/save_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
CombatFX="*res://scripts/autoload/combat_fx.gd"
Audio="*res://scripts/autoload/audio.gd"
TransitionManager="*res://scripts/autoload/transition_manager.gd"
CRTOverlay="*res://scripts/autoload/crt_overlay.gd"
ScreenshotHelper="*res://scripts/autoload/screenshot_helper.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/PressStart2P-Regular.ttf"
theme/default_font_size=16

