# Godot 4+ specific ignores
.godot/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# Build/export artifacts
build/

# macOS
.DS_Store

# Synty raw assets & Blender working files — licensed + large, staged locally.
# Keep the folder's README + .gdignore tracked so the convention travels.
synty_source/*
!synty_source/README.md
!synty_source/.gdignore
